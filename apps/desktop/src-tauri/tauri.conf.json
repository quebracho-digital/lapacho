{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lapacho",
  "version": "0.1.0",
  "identifier": "digital.quebracho.lapacho",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lapacho",
        "width": 440,
        "height": 660,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
